# Base URL of the NestJS API as seen by the browser.
# Leave as /api in development (Vite proxies it to VITE_PROXY_TARGET).
# For a production build served from a different domain, use the full URL,
# e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the Vite dev server forwards /api requests.
VITE_PROXY_TARGET=http://localhost:3000
