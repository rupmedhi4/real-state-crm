# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=estateflow_crm
# Used only by `npm run test:e2e` — its schema is dropped and rebuilt on every run
DB_NAME_TEST=estateflow_crm_test
DB_SSL=false
DB_LOGGING=false

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- File uploads ---
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10
MAX_IMAGES_PER_PROPERTY=20
# local = files on disk under UPLOAD_DIR; s3 = S3-compatible object storage
# (AWS S3, Cloudflare R2, Supabase). Use s3 on hosts with a temporary disk.
STORAGE_DRIVER=local
# Leave S3_ENDPOINT empty for AWS; R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- First admin login (npm run create-admin; works in production) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Development seed (npm run seed) ---
SEED_ADMIN_EMAIL=admin@estateflow.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_AGENT_PASSWORD=Agent@12345
