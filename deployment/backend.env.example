NODE_ENV=production
PORT=3000
SWAGGER_ENABLED=false
REGISTRATION_ENABLED=false
ALLOW_LEGACY_LOGIN=false
CORS_ORIGINS=https://crm.yourdomain.com
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
# Copy from Neon > Connect. Client workspaces use separate schemas in this database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
STORAGE_DRIVER=s3
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=client-crm-files
S3_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
MAX_IMAGES_PER_PROPERTY=20
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10
MASTER_ADMIN_EMAIL=owner@example.com
MASTER_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
MASTER_ADMIN_NAME=Master Admin
